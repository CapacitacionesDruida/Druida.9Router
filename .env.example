# Copia este archivo a .env y completa los valores.
# scripts/9router.sh setup (o 9router.ps1 setup) hace esto automaticamente
# y genera valores aleatorios para los secretos.

# --- Obligatorias ---
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/app/data

# --- Recomendadas (seguridad interna de 9Router) ---
API_KEY_SECRET=change-me-too
MACHINE_ID_SALT=change-me-as-well

# --- Runtime (no suele requerir cambios) ---
PORT=20128
NODE_ENV=production
HOSTNAME=0.0.0.0

# --- Observabilidad ---
OBSERVABILITY_ENABLED=true
ENABLE_REQUEST_LOGS=false

# --- Seguridad de red (activar si hay TLS/reverse proxy delante) ---
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# --- URLs publicas/internas ---
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# --- Proxy saliente hacia proveedores upstream (opcional) ---
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# --- Sidecar Headroom opcional (solo aplica si levantas el profile "headroom" ---
# --- de compose.yml, ej: `9router.sh start --with-headroom`). Si no lo usas, ---
# --- esta variable es inofensiva y se puede dejar como esta. ---
# HEADROOM_URL=http://headroom:8787
